{
  "name": "attendance-saas",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "build": "node scripts/hostinger-build.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "api:setup": "npm run setup -w @attendance/api",
    "api": "npm start -w @attendance/api",
    "web": "npm run dev -w @attendance/web"
  },
  "dependencies": {
    "@types/nodemailer": "^8.0.2",
    "nodemailer": "^10.0.15"
  }
}
